# ---------------------------------------------------------------------------
# Developer Skill & Job Recommendation Graph - environment template
#
# Copy this file to `.env` in the repository root and fill in real values.
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials to version control,
# and never paste them into issues, READMEs, screenshots or chat.
# ---------------------------------------------------------------------------

# --- CognoDB (required) ----------------------------------------------------
# Bolt connection URI from your CognoDB instance.
# Use `bolt+s://` (TLS) for hosted instances, `bolt://` only for a local one.
COGNODB_URI=bolt+s://your-instance-id.databases.cognodb.cloud

# Credentials for the CognoDB instance.
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=your-password-here

# Optional: target database name. Leave blank to use the instance default.
COGNODB_DATABASE=

# --- Server (required) -----------------------------------------------------
PORT=5000
NODE_ENV=development

# --- CORS (optional) -------------------------------------------------------
# Comma-separated list of allowed browser origins for the API.
# Only needed when the frontend is served from a different origin than the
# API (i.e. local development, or a split frontend/backend deployment).
# In single-origin production (Express serves the React build) this can be
# left blank.
CORS_ORIGIN=http://localhost:5173

# --- Frontend (optional) ---------------------------------------------------
# Only needed if the frontend is deployed separately from the backend.
# Left blank, the frontend calls `/api` on its own origin, and local
# development proxies `/api` to PORT via the Vite dev server.
# This value is compiled into the public JS bundle - never put secrets here.
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
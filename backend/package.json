{
  "name": "developer-skill-job-graph-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express API that answers job-recommendation questions by traversing a CognoDB graph.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seedDatabase.js",
    "verify:db": "node scripts/verifyDatabase.js",
    "check:cypher": "node scripts/validateCypher.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "neo4j-driver": "^5.28.3"
  },
  "devDependencies": {
    "@neo4j-cypher/language-support": "2.0.0-next.6"
  }
}
